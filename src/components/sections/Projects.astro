---
import BentoGrid from "@/components/magic-ui/BentoGrid.astro";
import BorderBeam from "@/components/magic-ui/BorderBeam.astro";
import { projects } from "@/data/projects";

const sortedProjects = [...projects].sort((a, b) => a.order - b.order);
const featuredProjects = sortedProjects.filter((project) => project.featured);

if (featuredProjects.length !== 1) {
  throw new Error(
    `Projects requires exactly one featured project; received ${featuredProjects.length}.`,
  );
}

const featuredProject = featuredProjects[0];
const supportingProjects = sortedProjects.filter((project) => !project.featured);
---

<section
  id="projects"
  class="section-spacing scroll-mt-28 overflow-clip md:scroll-mt-22"
  aria-labelledby="projects-title"
>
  <div class="page-container">
    <header class="mb-14 md:mb-20">
      <h2 id="projects-title">Projects</h2>
    </header>

    <BentoGrid class="projects-grid">
      {
        sortedProjects.map((project) => {
          const isFeatured = project.slug === featuredProject.slug;
          const supportingPosition = isFeatured
            ? undefined
            : supportingProjects.findIndex((item) => item.slug === project.slug) + 1;

          return (
            <article
              class:list={[
                "project-card",
                isFeatured && "project-card--featured",
                project.image && "project-card--with-media",
              ]}
              data-supporting-position={supportingPosition}
              role="listitem"
            >
              {isFeatured && (
                <BorderBeam
                  size={88}
                  duration={12}
                  colorFrom="var(--foreground)"
                  colorTo="var(--border-strong)"
                />
              )}

              {project.image && (
                <figure class="project-card__media">
                  <img
                    src={project.image}
                    alt={`${project.title} project preview`}
                    width="1600"
                    height="1000"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}

              <div class="project-card__body">
                <div class="project-card__intro">
                  {isFeatured && <p class="project-card__label">Featured project</p>}
                  <h3>{project.title}</h3>
                  <p class="project-card__description">{project.description}</p>
                </div>

                {isFeatured && project.highlights.length > 0 && (
                  <ul class="project-card__highlights" aria-label={`${project.title} highlights`}>
                    {project.highlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}
                  </ul>
                )}

                <div class="project-card__footer">
                  <ul class="project-card__stack" aria-label={`${project.title} technology stack`}>
                    {project.techStack.map((technology) => <li>{technology}</li>)}
                  </ul>

                  <div class="project-card__links">
                    <a
                      href={project.repositoryUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`View ${project.title} repository on GitHub (opens in a new tab)`}
                    >
                      GitHub <span aria-hidden="true">↗</span>
                    </a>

                    {project.liveUrl && (
                      <a
                        href={project.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`View ${project.title} live project (opens in a new tab)`}
                      >
                        Live project <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </BentoGrid>
  </div>
</section>

<style>
  .project-card {
    position: relative;
    min-width: 0;
    min-height: 24rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition:
      transform var(--duration-normal) var(--ease-standard),
      border-color var(--duration-normal) var(--ease-standard),
      background-color var(--duration-normal) var(--ease-standard);
  }

  .project-card--featured {
    min-height: 36rem;
    background: var(--surface-muted);
  }

  .project-card[data-supporting-position="2"] {
    background: var(--surface-muted);
  }

  .project-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .project-card__body {
    position: relative;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.5rem, 1.05rem + 1.5vw, 2.5rem);
  }

  .project-card--with-media .project-card__body {
    min-height: auto;
  }

  .project-card__intro {
    display: grid;
    gap: 1rem;
  }

  .project-card__label {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .project-card h3 {
    max-width: 16ch;
    font-size: clamp(1.75rem, 1.35rem + 1.6vw, 3rem);
  }

  .project-card:not(.project-card--featured) h3 {
    font-size: clamp(1.5rem, 1.25rem + 0.8vw, 2rem);
  }

  .project-card__description {
    max-width: 68ch;
    color: var(--muted-foreground);
    font-size: clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem);
    line-height: 1.65;
  }

  .project-card__highlights {
    display: grid;
    max-width: 52rem;
    gap: 0.65rem;
    margin: 0;
    padding-left: 1.15rem;
    color: var(--foreground);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .project-card__highlights li::marker {
    color: var(--border-strong);
  }

  .project-card__footer {
    display: grid;
    gap: 1.5rem;
    margin-top: auto;
  }

  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card__stack li {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.5rem 0.625rem;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .project-card__links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    border-bottom: 1px solid var(--border-strong);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }

  .project-card__links a span {
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .project-card__links a:hover,
  .project-card__links a:focus-visible {
    border-color: var(--foreground);
  }

  .project-card__links a:hover span,
  .project-card__links a:focus-visible span {
    transform: translate(0.2rem, -0.2rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      transform: translateY(-0.25rem);
      border-color: var(--border-strong);
    }

    .project-card:hover .project-card__media img {
      transform: scale(1.02);
    }
  }

  .project-card:focus-within {
    border-color: var(--border-strong);
  }

  @media (min-width: 48rem) {
    .project-card--featured {
      grid-column: span 2;
    }
  }

  @media (min-width: 64rem) {
    .project-card--featured {
      grid-column: span 8;
      grid-row: span 2;
      min-height: 44rem;
    }

    .project-card[data-supporting-position="1"],
    .project-card[data-supporting-position="2"] {
      grid-column: span 4;
      min-height: 21.5rem;
    }

    .project-card[data-supporting-position="3"] {
      grid-column: span 12;
      min-height: 22rem;
    }

    .project-card[data-supporting-position="3"] .project-card__body {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
      align-items: end;
    }

    .project-card[data-supporting-position="3"] .project-card__footer {
      align-self: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__media img,
    .project-card__links a,
    .project-card__links a span {
      transition: none;
    }

    .project-card:hover,
    .project-card__links a:hover span,
    .project-card__links a:focus-visible span,
    .project-card:hover .project-card__media img {
      transform: none;
    }
  }
</style>
