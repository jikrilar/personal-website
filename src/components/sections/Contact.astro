---
import ContactForm from "@/components/forms/ContactForm";
import BorderBeam from "@/components/magic-ui/BorderBeam.astro";
import Particles from "@/components/magic-ui/Particles";
---

<section
  id="contact"
  class="contact-section section-spacing scroll-mt-28 md:scroll-mt-22"
  aria-labelledby="contact-title"
>
  <div class="contact-section__particles" aria-hidden="true">
    <Particles
      client:visible
      className="contact-particles"
      quantity={34}
      staticity={90}
      ease={100}
      size={0.3}
    />
  </div>

  <div class="page-container contact-section__content">
    <header class="contact-section__header">
      <h2 id="contact-title">Send Message</h2>
      <p>Have a project, opportunity, or question? Send me a message.</p>
    </header>

    <div class="contact-card">
      <BorderBeam
        size={80}
        duration={14}
        colorFrom="var(--foreground)"
        colorTo="var(--border-strong)"
      />
      <ContactForm client:visible />
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .contact-section__particles {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    color: var(--foreground);
    opacity: 0.34;
    pointer-events: none;
  }

  :global(.contact-particles) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .contact-section__content {
    position: relative;
  }

  .contact-section__header {
    display: grid;
    max-width: 45rem;
    gap: 1rem;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .contact-section__header p {
    color: var(--muted-foreground);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.6;
  }

  .contact-card {
    position: relative;
    width: min(100%, 45rem);
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-section__particles {
      display: none;
    }
  }
</style>
